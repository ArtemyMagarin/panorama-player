{
  "name": "panorama-player",
  "version": "0.1.0",
  "description": "Browser-only WebGL2 panorama player for equirectangular images. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "size": "pnpm build && size-limit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,html}\"",
    "test:e2e": "pnpm build && pnpm e2e:fixture && playwright test",
    "e2e:install": "playwright install --with-deps",
    "e2e:fixture": "node e2e/scripts/generate-fixture.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "panorama",
    "equirectangular",
    "webgl2",
    "360",
    "viewer",
    "player"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
